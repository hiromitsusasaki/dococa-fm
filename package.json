{
  "name": "dococa-fm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "collect": "node --env-file-if-exists=.dev.vars scripts/collect-found-voices.ts",
    "seed": "node --env-file-if-exists=.dev.vars scripts/seed-demo-letters.ts",
    "db:migrate:local": "wrangler d1 migrations apply dococa --local",
    "db:migrate": "wrangler d1 migrations apply dococa --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@hono/mcp": "^0.3.5",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
