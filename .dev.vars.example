# Claude API のキー（台本生成）
ANTHROPIC_API_KEY=
# Spotify Developer Dashboard のアプリの Client ID（PKCE のため secret は不要）
SPOTIFY_CLIENT_ID=
# Google Cloud のサービスアカウント（ロール Vertex AI User）の JSON キーを 1 行にしたもの。Gemini-TTS は API キーでは使えない
GOOGLE_TTS_SA_JSON=
# TMDB の API キー（映画の検索）
TMDB_API_KEY=
# YouTube Data API v3 のキー（見つけた声の収集）
YOUTUBE_API_KEY=
# 管理 API の Bearer トークン
ADMIN_TOKEN=
# セッション cookie の署名用ランダム文字列
SESSION_SECRET=
# この app を配信する origin。開発は http://127.0.0.1:5173。空だと全リクエストが 500 になる
# （本番は wrangler.jsonc の vars に書く）
PUBLIC_ORIGIN=http://127.0.0.1:5173
# 開発専用: 1 にすると、ANTHROPIC_API_KEY が空のときにお便りの判定と翻訳を素通しにする。本番では設定しない
DEV_SKIP_CLAUDE=1
# 任意: 1 リスナー 1 日の番組生成の上限
EPISODE_DAILY_LIMIT=10
# 任意: 全リスナー合計の 1 日の番組生成の上限（既定 300。0 で停止）
EPISODE_GLOBAL_DAILY_LIMIT=300
# 任意: クラウド TTS を使う回の 1 日の上限（既定 50。0 で停止）
CLOUD_TTS_GLOBAL_DAILY_LIMIT=50
# 任意: 1 分あたりの書き込みの上限（IP・リスナーごと。既定 20）
RATE_LIMIT_PER_MINUTE=20
# 任意: 台本生成に使う Claude のモデル
CLAUDE_MODEL=claude-sonnet-5-5
# 任意: クラウド TTS のモデル（既定 gemini-2.5-flash-tts）
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
# 任意: クラウド TTS の声。male = Charon、female = Kore（既定 male）
GEMINI_TTS_VOICE=male
