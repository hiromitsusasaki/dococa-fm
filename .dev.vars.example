# Workers AI（作品のベクトル）に鍵は要らない。wrangler.jsonc の ai バインディングと、開発機の `pnpm wrangler login` で使う
# Claude API のキー（台本生成）
ANTHROPIC_API_KEY=
# Spotify Developer Dashboard のアプリの Client ID（PKCE のため secret は不要）
SPOTIFY_CLIENT_ID=
# Google Cloud の OAuth クライアント（ウェブ アプリケーション）。承認済みのリダイレクト URI は ${PUBLIC_ORIGIN}/auth/google/callback。ID が空だと /auth/google は 503
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud のサービスアカウント（ロール Vertex AI User）の JSON キーを 1 行にしたもの。Gemini-TTS は API キーでは使えない
GOOGLE_TTS_SA_JSON=
# TMDB の API キー（映画の検索）
TMDB_API_KEY=
# YouTube Data API v3 のキー（見つけた声の収集）
YOUTUBE_API_KEY=
# 任意: Google Books API のキー（Library で Books API を有効化して作る。YouTube のキーに Books API を足して同じ値でもよい）。無いと鍵なしの共有枠で 429 になり本が解決できない
GOOGLE_BOOKS_API_KEY=
# 管理 API の Bearer トークン
ADMIN_TOKEN=
# セッション cookie の署名用ランダム文字列
SESSION_SECRET=
# この app を配信する origin。開発は http://127.0.0.1:5173。空だと全リクエストが 500 になる
# （本番は wrangler.jsonc の vars に書く）
PUBLIC_ORIGIN=http://127.0.0.1:5173
# 開発専用: 1 にすると、ANTHROPIC_API_KEY が空のときにお便りの判定と翻訳を素通しにする。本番では設定しない
DEV_SKIP_CLAUDE=1
# 任意: 1 リスナー 1 日に作る枠（1 回 = 1 枠）の上限（既定 60。0 で停止）
EPISODE_DAILY_LIMIT=60
# 任意: 全リスナー合計の 1 日に作る枠の上限（既定 1800。0 で停止）
EPISODE_GLOBAL_DAILY_LIMIT=1800
# 任意: クラウド TTS で 1 日に合成する行数の上限（既定 3000。0 で停止）
CLOUD_TTS_GLOBAL_DAILY_LIMIT=3000
# 任意: 1 日に作る単位（お便りごとの DJ の語り。1 つで Claude を 1〜数回呼ぶ）の上限（既定 1000。0 で停止）
UNIT_DAILY_LIMIT=1000
# 任意: /put で作品を選んだときの DJ の問いと、書きかけへの問い返し（どちらも 1 回で Claude を 1 回呼ぶ。合わせて数える）を 1 日に出す回数の上限（全員合計。既定 600。0 で停止）
ELICIT_DAILY_LIMIT=600
BRIDGE_DAILY_LIMIT=400
# 任意: 題名検索（/put）が YouTube を探す回数の 1 日の上限（全員合計。1 回で YouTube の枠を 100 ユニット使う。既定 80。0 で YouTube を探さない）
YOUTUBE_SEARCH_DAILY_LIMIT=80
# 任意: 全員合計で 1 日に受け付けるお便りと一言の上限（1 通ごとに判定と翻訳で Claude を呼ぶ。「私も」と見つけた声は数えず、止めない。既定 500。0 で停止）
LETTER_GLOBAL_DAILY_LIMIT=500
# 任意: 1 分あたりの書き込みの上限（IP・リスナーごと。既定 20）
RATE_LIMIT_PER_MINUTE=20
# 任意: 台本生成に使う Claude のモデル
CLAUDE_MODEL=claude-sonnet-5-5
# 任意: クラウド TTS のモデル（既定 gemini-2.5-flash-tts）
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
# 任意: クラウド TTS の声。male = Charon、female = Kore（既定 male）
GEMINI_TTS_VOICE=male
