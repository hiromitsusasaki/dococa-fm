{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dococa-fm",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "dococa", "database_id": "9f0f6a94-2634-4da3-9d7f-c93212f55639", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dococa-audio" }],
  // Workers AI: work embeddings (@cf/baai/bge-m3) for the dial's distance (src/worker/ai/embed.ts). Optional: without it the pick falls back to the pools.
  "ai": { "binding": "AI", "remote": true },
  "assets": { "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
  // The custom domain (Cloudflare Registrar zone). Other hosts, including workers.dev, redirect here.
  "routes": [{ "pattern": "dococafm.app", "custom_domain": true }],
  // Keep the workers.dev host alive so old links land on the redirect to PUBLIC_ORIGIN; no per-version preview urls.
  "workers_dev": true,
  "preview_urls": false,
  // Pre-generates units and audio for letters that missed the post-insert hook (src/worker/program/prepare.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Must match the custom domain above: it drives the same-origin check, the Secure cookie, the Spotify
  // redirect and the station url. Empty refuses every request with 500. Local dev sets it in .dev.vars.
  "vars": { "PUBLIC_ORIGIN": "https://dococafm.app" }
}
